# Este .env fica na RAIZ do projeto (ao lado de docker-compose.yml) e é lido
# pelo próprio `docker compose` para substituir ${VARS} nesse arquivo — é
# diferente do backend/.env, que é lido pela aplicação Laravel.
#
# Gere valores fortes e únicos por ambiente, por exemplo:
#   openssl rand -base64 32
#
# IMPORTANTE: os mesmos valores precisam ser copiados para backend/.env em
# DB_PASSWORD e REDIS_PASSWORD, senão a aplicação não autentica no Postgres/Redis.

POSTGRES_PASSWORD=troque-por-uma-senha-forte
REDIS_PASSWORD=troque-por-uma-senha-forte
