APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Precisa ser maior que o timeout do ProcessPncpPageJob (900s)
REDIS_QUEUE_RETRY_AFTER=960

# O limitador de taxa global substitui as pausas manuais entre requisições.
PNCP_PAGE_STAGGER_SECONDS=0
PNCP_DOCUMENT_DELAY_MS=0

# Minutos de espera adicionados por modalidade na fila do dia antes de
# despachar a Fase 2 (documentos). Evita que várias modalidades que terminam
# a listagem quase juntas bombardeiem /arquivos ao mesmo tempo.
PNCP_DOCUMENTS_STAGGER_MINUTES=8

# Timeouts: dimensionados pela latência das respostas boas, não pela da falha.
PNCP_HTTP_CONNECT_TIMEOUT=5
PNCP_HTTP_TIMEOUT=40
PNCP_HTTP_DOCUMENT_TIMEOUT=10
PNCP_HTTP_RETRIES=2
PNCP_HTTP_RETRY_SLEEP_MS=3000

# Teto de req/s somando todos os workers e os dois endpoints do PNCP.
# Se aparecer 429: baixar para 4. Se ficar limpo: subir para 8.
PNCP_MAX_REQUESTS_PER_SECOND=6
PNCP_THROTTLE_BLOCK_SECONDS=10

# Circuit breaker
PNCP_BREAKER_5XX_THRESHOLD=3
PNCP_BREAKER_PROBE_SECONDS=120
PNCP_CIRCUIT_BREAKER_MINUTES=2
PNCP_RETRY_UNTIL_HOURS=6

# Válvula de escape: após N sondagens falhas seguidas no nível máximo, a
# pausa passa a ser esta (bem maior), reduzindo ruído numa degradação real.
PNCP_BREAKER_PROLONGED_OUTAGE_THRESHOLD=3
PNCP_BREAKER_PROLONGED_OUTAGE_BACKOFF_MINUTES=60

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
